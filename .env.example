# --- Local CLI / webui (single-user, local .env) ---

# Groq (free tier) - get a key at https://console.groq.com
GROQ_API_KEY=

# GitHub token with repo:read scope, used to pull PR diffs
GITHUB_TOKEN=

# Model to use on Groq (open-source, hosted)
GROQ_MODEL=openai/gpt-oss-120b


# --- Hosted multi-tenant server (server/app.py) ---
# Not needed for the CLI/webui above -- only for running the hosted app
# (login + dashboard + webhook), typically deployed on Render.

# From your GitHub App's settings page (github.com/settings/apps)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the downloaded .pem private key's contents here
GITHUB_APP_PRIVATE_KEY=
# A random string you choose when creating the App's webhook
GITHUB_WEBHOOK_SECRET=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Postgres connection string (Render's free Postgres add-on sets this
# automatically); omit to fall back to a local SQLite file for dev
DATABASE_URL=
